// ═══════════════════════════════════════════════════════════════════════
// ORD 账本模板 v1.0(2026-10-22 定稿) — 给任何 Pine 指标套用的逐笔可对账账本
// ───────────────────────────────────────────────────────────────────────
// 这是什么:一段可整段粘贴进任意 indicator() 脚本的记账代码块。
// 它让宿主指标在运行时把每一笔模拟交易记成 CSV 行,经 Pine 日志
// (log.info)导出:首行 CFG 自证参数,每笔平仓一行 ORD,数据末端
// 未平仓一行 HOL —— 导出后可与外部回测引擎逐笔对账。
//
// 设计理念:先有账,再谈信号。指标自带可导出、可对账的逐笔流水,
// 是把「图上看着对」变成「数字查得清」的前提。
//
// 来源:抽自两份已落地实现 ——
// ① SMC 全战法·砚舟 v4 的 ORD 逐笔明细(扩展字段版,宿主策略字段更多)
// ② UT Bot + ORD 账本 v2.1 的 CFG/ORD/HOL 三行式(标准字段版)
// 本模板的标准字段集与 ② 逐字同构(ORD 14 字段 / HOL 8 字段 /
// CFG 为 k=v 串),现有 compare 类对账工具可直接复用、无需改解析。
//
// 落地实证(两个实例都已完成 TV ↔ Python 引擎逐笔校准):
// ① 砚舟 v4:39/42 笔逐笔配对,配对单进场价差为 0,并据此查出
// 「TV 实例实际参数(14/0.3)与源码默认值(5/0.2)不一致」的根源问题。
// ② UT Bot 账本版(2026-10-22 校准通过):窗内 614 笔与引擎配对率
// 100%、真分歧 0;613 对双方真实平仓单的入场价差、出场价差
// 613/613 全为 0.000000,双源净 R 同为 +150.9864R。
// (校准证明的是账记得对、引擎算得对,不构成对任何指标盈利能力的证明。)
//
// 用法:把下方到整段粘贴到你的
// indicator() 声明之后,然后在宿主的信号/开仓/平仓事件处调用三个
// 函数(见区块内「宿主接入点」标记与文件末尾的演示宿主)。
// 本文件自带一个最简演示宿主(EMA 快慢线交叉),可直接加到图表上
// 验证账本工作;套用到自己指标时,删掉演示宿主、保留模板区块即可。
//
// 许可:本模板区块本身采用 MIT(见仓库根目录 LICENSE 文件);
// 宿主指标的逻辑各归其作者所有。UT Bot 本体为 QuantNomad 作品(MPL-2.0)。
// ═══════════════════════════════════════════════════════════════════════

//@version=6
indicator("ORD 账本模板 · 演示宿主(EMA交叉)", shorttitle = "ORD Ledger", overlay = true)


// ╔═══════════════════════════════════════════════════════════════════╗
// ║ 整段复制到宿主 indicator() 声明之后 ║
// ╚═══════════════════════════════════════════════════════════════════╝

// ── 1. 参数组(宿主接入点 0:把下面三个字符串改成你指标的实际值)──
ordName    = input.string("未命名指标", "CFG·脚本名", group = "ORD 账本", tooltip = "会打进日志首行 CFG 自证。不要带逗号。")
ordStyle   = input.string("翻转出场", "CFG·交易口径", group = "ORD 账本", tooltip = "一句话写清出场口径,如:翻转出场 / 止损止盈出场。不要带逗号。")
ordRDef    = input.string("进场根 nLoss(KV×ATR)", "CFG·R 定义", group = "ORD 账本", tooltip = "一句话写清 R 距离的定义,如:进场价到止损价距离。不要带逗号。")
ordLog     = input.bool(true, "导出逐笔明细到 Pine 日志 (CSV)", group = "ORD 账本", tooltip = "每笔平仓输出一行 ORD;数据末端未平仓输出 HOL 行;首行 CFG 自证参数。用完可关。")
ordCapital = input.float(400.0, "本金 U", step = 10, group = "ORD 账本", tooltip = "仅用于把 R 折算成 U:每笔计划风险 = 本金 × 风险%。")
ordRiskPct = input.float(1.0, "每笔计划风险 %", step = 0.1, group = "ORD 账本", tooltip = "默认 1%。净U = 净R × (本金 × 风险%)。")
ordFeePct  = input.float(0.05, "手续费 %/边", step = 0.01, group = "ORD 账本", tooltip = "按价格口径扣:手续费R = 费率 × (开仓价 + 平仓价) / R距离。默认 0.05%/边。")
ordShowTbl = input.bool(true, "显示状态小表", group = "ORD 账本")
ordTblPos  = input.string("右上", "状态小表位置", options = ["右上", "右下", "左上", "左下"], group = "ORD 账本")

// 派生口径(勿改公式;与两份已落地实现逐字对齐)
float ordRiskU   = ordCapital * ordRiskPct / 100.0  // 每笔计划风险 U(默认 400×1% = 4U)
float ordFeeRate = ordFeePct / 100.0               // 手续费率(默认 0.0005)

// ── 2. 账本状态(全部 ord_ 前缀,避免与宿主变量撞名)──
var int   ordPosDir    = 0     // 1=多 / -1=空 / 0=空仓(本模板为单仓账本)
var float ordEntryPx   = na    // 开仓价
var float ordEntryRd   = na    // 进场根 R 距离(由宿主在开仓时提供)
var int   ordEntryTime = na    // 开仓根 time_close(UTC 收盘时刻,毫秒)
var int   ordEntryBar  = na    // 开仓根 bar_index(算持仓根数用)
var int   ordOidSeq    = 0     // 单号计数(开仓时自增)
var int   ordClosedCnt = 0     // 已平仓笔数
var int   ordSigLong   = 0     // 多头信号数(宿主经 f_ord_signal 上报)
var int   ordSigShort  = 0     // 空头信号数
var bool  ordHdrDone   = false // CFG+表头只打一次
var int   ordHolBar    = na    // HOL 快照去重(同一根只打一行)

// ── 3. 工具函数 ──
// 毫秒时间戳 → "yyyy-MM-dd HH:mm"(UTC)。账本时间一律 UTC、记 K 线收盘时刻;
// 外部引擎记 K 线开始时刻,换算:引擎时刻 = TV 时刻 − 图表周期。
f_ord_ms(int v) =>
    na(v) ? "NA" : str.format_time(v, "yyyy-MM-dd HH:mm", "UTC")

f_ord_pos(string s) =>
    s == "右下" ? position.bottom_right : s == "左上" ? position.top_left : s == "左下" ? position.bottom_left : position.top_right

// 收盘确认门控(推荐宿主在信号条件里 AND 上它):
// 只抑制「正在形成的最后一根」,历史根恒放行。实时最后一根在收盘那一刻
// isconfirmed 变 true,信号照常在收盘触发,收盘确认口径不变。
// (教训来源:UT Bot 账本 v1 曾用 barstate.isconfirmed 直接门控全部根,
// 结果历史根上被门控的输出全灭 —— 不要那样写。)
f_ord_confirmed() =>
    not barstate.islast or barstate.isconfirmed

// ── 4. 记账 API(宿主接入点 1/2/3,见文件末尾演示)──

// 宿主每产生一个已确认信号时调用一次,
// 只计数供状态小表与 CFG 后对账核对,不影响开平仓。dir: 1=多 / -1=空。
f_ord_signal(int dir) =>
    if dir == 1
        ordSigLong := ordSigLong + 1
    else if dir == -1
        ordSigShort := ordSigShort + 1
    ordSigLong + ordSigShort

// 在宿主的开仓事件处调用。
// dir: 1=多 / -1=空
// px: 开仓成交价(口径由宿主定,一般为信号根收盘价)
// rd: 本笔的 R 距离(价格单位),由宿主提供 —— 常见定义见接入指南:
//     ATR 倍数 / 进场价到止损价距离 / 固定百分比,任选其一并写进 CFG 的 R 定义。
// tClose: 开仓根的 time_close(UTC 收盘时刻,毫秒),一般直接传 time_close。
// 返回本笔单号;已有持仓 / rd 无效(na 或 ≤0)时不开仓、返回 na。
// 注意:同根先平仓再反手时,先调 f_ord_close 再调 f_ord_open(与引擎同序)。
f_ord_open(int dir, float px, float rd, int tClose) =>
    int res = na
    if ordPosDir == 0 and (dir == 1 or dir == -1) and not na(px) and not na(rd) and rd > 0
        ordOidSeq    := ordOidSeq + 1
        ordPosDir    := dir
        ordEntryPx   := px
        ordEntryRd   := rd
        ordEntryTime := tClose
        ordEntryBar  := bar_index
        res          := ordOidSeq
    res

// 在宿主的平仓事件处调用,输出一行 ORD。
// px: 平仓成交价
// reason: 退出原因(自由文本,如:翻转 / 止损 / 止盈 / 超时 —— 不要带逗号)
// tClose: 平仓根的 time_close,一般直接传 time_close。
// 返回本笔净 R;无持仓时返回 na、不输出。
// 净R = ((平仓价 − 开仓价) × 方向 − 费率 × (开仓价 + 平仓价)) / R距离;净U = 净R × 每笔计划风险。
f_ord_close(float px, string reason, int tClose) =>
    float res = na
    if ordPosDir != 0 and not na(px)
        int d       = ordPosDir
        float gR    = (px - ordEntryPx) * d / ordEntryRd
        float feeR  = ordFeeRate * (ordEntryPx + px) / ordEntryRd
        float nR    = gR - feeR
        ordClosedCnt := ordClosedCnt + 1
        if ordLog
            log.info(str.format("ORD,{0},{1},{2},{3},{4,number,#.######},{5,number,#.######},{6},{7,number,#.######},{8,number,#.####},{9,number,#.####},{10,number,#.####},{11,number,#.##},{12}", ordOidSeq, d == 1 ? "多" : "空", f_ord_ms(ordEntryTime), f_ord_ms(tClose), ordEntryPx, px, reason, ordEntryRd, gR, feeR, nR, nR * ordRiskU, bar_index - ordEntryBar))
        res          := nR
        ordPosDir    := 0
        ordEntryPx   := na
        ordEntryRd   := na
        ordEntryTime := na
        ordEntryBar  := na
    res

// 模板尾巴每根自动调用,宿主不用管:
// 在最后一根上、若有未平仓仓位,输出一行 HOL(同单号每根一行,对账时取最后一行;
// 已有 ORD 的单号在对账时忽略其 HOL)。对应外部引擎的 data_end 末笔。
f_ord_snapshot() =>
    if ordLog and barstate.islast and ordPosDir != 0 and ordHolBar != bar_index
        ordHolBar := bar_index
        float uR = ((close - ordEntryPx) * ordPosDir - ordFeeRate * (ordEntryPx + close)) / ordEntryRd
        log.info(str.format("HOL,{0},{1},{2},{3,number,#.######},{4,number,#.######},{5,number,#.######},{6,number,#.####}", ordOidSeq, ordPosDir == 1 ? "多" : "空", f_ord_ms(ordEntryTime), ordEntryPx, ordEntryRd, close, uR))
    ordPosDir

// ── 5. CFG 首行 + 表头(脚本首根各打印一次,CFG 在最前,参数与周期自证)──
if not ordHdrDone
    ordHdrDone := true
    if ordLog
        log.info(str.format("CFG,脚本={0},账本=ORD模板v1.0,图表周期={1},蜡烛=真实K线,口径={2},R定义={3},手续费={4,number,#.###}%/边,净U=净R*{5,number,#.##}U,时间=UTC收盘时刻,数据首根={6}", ordName, timeframe.period, ordStyle, ordRDef, ordFeePct, ordRiskU, str.format_time(time, "yyyy-MM-dd HH:mm", "UTC")))
        log.info("ORD,编号,方向,开仓时间,平仓时间,开仓价,平仓价,退出原因,R距离,毛R,手续费R,净R,净U,持仓根数")
        log.info("HOL,编号,方向,开仓时间,开仓价,R距离,最新收盘,未实现净R")

// ── 6. 状态小表(只在最后一根刷新;不开日志也能一眼确认账本在工作)──
var table ordTbl = table.new(f_ord_pos(ordTblPos), 2, 6, border_width = 1)
f_ord_table() =>
    if ordShowTbl and barstate.islast
        string posTxt = ordPosDir == 1 ? "多 @ " + str.tostring(ordEntryPx, "#.####") : ordPosDir == -1 ? "空 @ " + str.tostring(ordEntryPx, "#.####") : "空仓"
        table.cell(ordTbl, 0, 0, "ORD 账本", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
        table.cell(ordTbl, 1, 0, "v1.0", text_color = color.white, bgcolor = color.new(color.gray, 20), text_size = size.small)
        table.cell(ordTbl, 0, 1, "信号总数", text_color = color.white, text_size = size.small)
        table.cell(ordTbl, 1, 1, str.tostring(ordSigLong + ordSigShort), text_color = color.white, text_size = size.small)
        table.cell(ordTbl, 0, 2, "多头信号", text_color = color.white, text_size = size.small)
        table.cell(ordTbl, 1, 2, str.tostring(ordSigLong), text_color = color.new(color.green, 0), text_size = size.small)
        table.cell(ordTbl, 0, 3, "空头信号", text_color = color.white, text_size = size.small)
        table.cell(ordTbl, 1, 3, str.tostring(ordSigShort), text_color = color.new(color.red, 0), text_size = size.small)
        table.cell(ordTbl, 0, 4, "已平仓笔数", text_color = color.white, text_size = size.small)
        table.cell(ordTbl, 1, 4, str.tostring(ordClosedCnt), text_color = color.white, text_size = size.small)
        table.cell(ordTbl, 0, 5, "当前持仓", text_color = color.white, text_size = size.small)
        table.cell(ordTbl, 1, 5, posTxt, text_color = color.white, text_size = size.small)
    ordPosDir

// ── 7. 模板尾巴(每根执行,内部自带门控)──
// 这两行就地保留也能工作(HOL/状态表只对最后一根生效,实时图上后续
// tick 会自动补正)。但最稳妥的做法:把这两行剪切到整个宿主脚本的
// 最末尾 —— 保证最后一根上「先记账、后快照」的顺序与原版实现一致。
f_ord_snapshot()
f_ord_table()

// ╔═══════════════════════════════════════════════════════════════════╗
// ║ 以上整段粘贴进宿主即可,以下为演示宿主 ║
// ╚═══════════════════════════════════════════════════════════════════╝


// ───────────────────────────────────────────────────────────────────
// 演示宿主:最简 EMA 快慢线交叉 + 翻转出场,只为演示三个接入点怎么调。
// R 距离用 2×ATR(14) —— 换成你自己的口径时,记得同步改 CFG 的 R 定义。
// ───────────────────────────────────────────────────────────────────
emaFast = ta.ema(close, 9)
emaSlow = ta.ema(close, 21)
plot(emaFast, "EMA9(演示)", color = color.new(color.teal, 0))
plot(emaSlow, "EMA21(演示)", color = color.new(color.orange, 0))

float demoRd  = 2.0 * ta.atr(14)
bool goLong   = ta.crossover(emaFast, emaSlow) and f_ord_confirmed()   // 收盘确认门控
bool goShort  = ta.crossunder(emaFast, emaSlow) and f_ord_confirmed()

if goLong
    f_ord_signal(1)                                // 接入点 1:信号登记
    if ordPosDir == -1
        f_ord_close(close, "翻转", time_close)     // 接入点 3:先平旧仓
    f_ord_open(1, close, demoRd, time_close)       // 接入点 2:再开新仓

if goShort
    f_ord_signal(-1)                               // 接入点 1
    if ordPosDir == 1
        f_ord_close(close, "翻转", time_close)     // 接入点 3
    f_ord_open(-1, close, demoRd, time_close)      // 接入点 2

plotshape(goLong, title = "Buy(演示)", text = "Buy", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.new(color.white, 0), size = size.tiny)
plotshape(goShort, title = "Sell(演示)", text = "Sell", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.new(color.white, 0), size = size.tiny)
